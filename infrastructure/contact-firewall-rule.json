{
  "name": "SMF contact submission limit",
  "description": "Contact handler only; SDK ID smf-contact-submit. Six attempts per ten minutes per rate key and Vercel region.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        {
          "type": "rate_limit_api_id",
          "op": "eq",
          "value": "smf-contact-submit"
        }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "algo": "fixed_window",
        "window": 600,
        "limit": 6,
        "keys": [
          "ip"
        ],
        "action": "rate_limit"
      }
    }
  }
}
